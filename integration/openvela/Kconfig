rsource "source/Kconfig.embt"

menuconfig EMBT_BTSHELL
	bool "EmBT Bluetooth shell"
	depends on EMBT_STACK
	select BT_SHELL

if EMBT_BTSHELL
config EMBT_BTSHELL_STACKSIZE
	int "btshell task stack size"
	default 16384
config EMBT_BTSHELL_PRIORITY
	int "btshell task priority"
	default 100
endif

config EMBT_PORT_TESTS
	bool "EmBT platform contract tests"
	depends on EMBT_STACK && TESTING_CMOCKA && SETTINGS
