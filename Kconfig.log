menuconfig EMBT_LOG
	bool "EmBT logging"
	default y
	help
	  Enable the internal synchronous LOG provider and module configuration.
	  Disabling this switch suppresses all LOG output and its arguments.

if EMBT_LOG

config EMBT_LOG_LEVEL
	int "Default log level (0=off, 1=error, 2=warning, 3=info, 4=debug)"
	range 0 4
	default 3
	help
	  Modules configured as -1 follow this level after configuration reloads.
	  Explicit module levels may be higher or lower than this default.
	  The global runtime filter initially allows all compiled module levels.

config EMBT_LOG_SNIFFER_INFO
	bool "Bluetooth sniffer information"
	default n
	help
	  Enable the original identity and pairing-key diagnostics for sniffers.
	  Output still requires the corresponding module and runtime log levels.
	  Disabled independently of the general debug log level.

