{
  "runner": "cmocka",
  "tags": [
    "bluetooth",
    "audio",
    "cmocka"
  ],
  "timeout_s": 45,
  "execution": "case",
  "scenarios": {
    "default": {},
    "bluetooth.audio.ascs.test_snk_only": {
      "options": [
        "CONFIG_BT_ASCS_MAX_ASE_SRC_COUNT=0"
      ],
      "required_cases": [
        "ascs_test_suite__test_has_sink_ase_chrc"
      ]
    },
    "bluetooth.audio.ascs.test_src_only": {
      "options": [
        "CONFIG_BT_ASCS_MAX_ASE_SNK_COUNT=0"
      ],
      "required_cases": [
        "ascs_test_suite__test_has_source_ase_chrc"
      ]
    },
    "bluetooth.audio.ascs.test_unicast_client_enabled": {
      "options": [
        "CONFIG_BT_CENTRAL=y",
        "CONFIG_BT_ISO_CENTRAL=y",
        "CONFIG_BT_BAP_UNICAST_CLIENT=y",
        "CONFIG_BT_GATT_CLIENT=y",
        "CONFIG_BT_GATT_AUTO_DISCOVER_CCC=y",
        "CONFIG_BT_GATT_AUTO_UPDATE_MTU=y"
      ],
      "required_cases": [
        "ascs_test_suite__test_has_control_point_chrc"
      ]
    },
    "bluetooth.audio.ascs.test_stream_pair": {
      "options": [
        "CONFIG_BT_ASCS_MAX_ACTIVE_ASES=2"
      ],
      "required_cases": [
        "test_ase_control_params__test_codec_configure_number_of_ases_above_max"
      ]
    }
  }
}
