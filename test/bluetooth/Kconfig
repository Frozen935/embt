menuconfig EMBT_TEST_CONFIG
	bool "Upstream Bluetooth test configuration"
	default n

if EMBT_TEST_CONFIG

config TEST_RL_SIZE
	int "Resolving list size reported by the test driver"
	default 8
	help
	  Zero makes the host resolve addresses itself.


# SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
# SPDX-License-Identifier: Apache-2.0

config TEST_DRIVER_NO_CLOSE
	bool "Give the test HCI driver no close() op"
	help
	  Build the test HCI driver without a close() op, as several in-tree
	  HCI drivers are, so that bt_disable() cannot close the transport.

config TEST_CTLR_STOPS
	bool "Run only the test with a controller that stops responding"
	help
	  Run only the test where the controller answers HCI Reset and then
	  stops responding. The Host asserts in that test, so no other test can
	  run after it.

config TEST_SEND_BLOCKS
	bool "Run only the test with a driver that blocks in send()"
	help
	  Run only the test where the driver stays in send() for longer than
	  the command timeout of the Host. The Host asserts in that test, so no
	  other test can run after it.


# SPDX-FileCopyrightText: Copyright (c) 2026 Xiaomi Corporation
# SPDX-License-Identifier: Apache-2.0

config TEST_SIX_BUFFERS
	bool "Run only the test with six controller buffers"
	help
	  Give the Host six controller buffers instead of one, and let the
	  test decide when the controller reports packets as completed, so
	  that one connection can hold every buffer.


config TEST_NO_ADV_TERM_ON_DIR_TIMEOUT
	bool "Report directed advertising timeout with connection complete only"
	help
	  Set the real transport quirk used by the original overlay-based test.

endif
