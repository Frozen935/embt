{
  "runner": "cmocka",
  "tags": [
    "bluetooth",
    "host_disable",
    "cmocka",
    "host",
    "async"
  ],
  "timeout_s": 45,
  "execution": "case",
  "scenarios": {
    "default": {},
    "bluetooth.host_disable.no_close": {
      "options": [
        "CONFIG_TEST_DRIVER_NO_CLOSE=y"
      ],
      "required_cases": [
        "bt_disable__test_driver_without_close_op"
      ]
    },
    "bluetooth.host_disable.ctlr_stops": {
      "options": [
        "CONFIG_TEST_CTLR_STOPS=y"
      ],
      "required_cases": [
        "bt_ctlr_stops__test_enable_ctlr_stops"
      ]
    },
    "bluetooth.host_disable.send_blocks": {
      "options": [
        "CONFIG_TEST_SEND_BLOCKS=y"
      ],
      "required_cases": [
        "bt_send_blocks__test_enable_send_blocks"
      ]
    },
    "bluetooth.host_disable.conn": {
      "options": [
        "CONFIG_BT_PERIPHERAL=y",
        "CONFIG_BT_GATT_CLIENT=y",
        "CONFIG_BT_SMP=y"
      ],
      "required_cases": [
        "bt_conn_tx__test_data_send_failure"
      ]
    }
  }
}
