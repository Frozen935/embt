menuconfig EMBT_AUDIO_DRIVER
	bool "PCM playback drivers"
	default n

if EMBT_AUDIO_DRIVER

config EMBT_AUDIO_PULSE
	bool "Native PulseAudio backend"
	default n
	help
	  Link the installed libpulse client. The target must provide a reachable
	  PulseAudio-compatible server. This does not enable Bluetooth audio profiles.

config EMBT_AUDIO_DRIVERS
	int "Maximum registered audio backends"
	range 1 8
	default 4

config EMBT_AUDIO_STREAMS
	int "Maximum concurrent PCM streams"
	range 1 16
	default 4

config EMBT_AUDIO_QUEUE_BLOCKS
	int "PCM blocks per stream"
	range 2 128
	default 32

config EMBT_AUDIO_BLOCK_BYTES
	int "Maximum copied PCM block size"
	range 1920 8192
	default 2048

config EMBT_A2DP_PLAYER
	bool "Shared SBC playback component"
	depends on LIBSBC
	default n

config EMBT_BAP_PLAYER
	bool "Shared LC3 playback component"
	depends on LIBLC3
	default n

endif
